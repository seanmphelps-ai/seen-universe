{
  "name": "seen-universe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:location:live": "tsx scripts/verify-location-live.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "pwa:build": "next build",
    "ios:add": "npm run pwa:build && cap add ios",
    "ios:sync": "npm run pwa:build && cap sync ios",
    "ios:open": "cap open ios",
    "android:add": "npm run pwa:build && cap add android",
    "android:sync": "npm run pwa:build && cap sync android",
    "android:open": "cap open android",
    "native:sync": "npm run pwa:build && cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/local-notifications": "^8.1.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@revenuecat/purchases-capacitor": "^13.2.2",
    "luxon": "^3.7.2",
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "swisseph-wasm": "^0.1.0",
    "tz-lookup": "^6.1.25",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/luxon": "^3.7.4",
    "@types/node": "22.15.33",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@types/tz-lookup": "^6.1.2",
    "tsx": "^4.23.12",
    "typescript": "5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
